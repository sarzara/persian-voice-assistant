# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Comma-separated numeric Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=111111111
# Only change to use a Bot API gateway (see docs/DEPLOY.md "Outbound access")
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- Owner (used by the seed script and the test-email CLI) ---
OWNER_TELEGRAM_ID=111111111
OWNER_NAME=Sahar
OWNER_EMAIL=owner@example.com

# --- Email (Resend) ---
RESEND_API_KEY=re_replace_me
# Must be on a domain verified in Resend; onboarding@resend.dev works for tests sent to your own Resend account email
EMAIL_FROM=Assistant <onboarding@resend.dev>
RESEND_API_URL=https://api.resend.com

# --- Outbound proxy (optional; docs/DEPLOY.md "Outbound access") ---
# When set, every outbound API call (Telegram, DeepSeek, Google, Resend) goes through this proxy.
# http://user:pass@host:port or socks5://user:pass@host:port. NO_PROXY keeps internal traffic direct.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,db,api,dashboard,mcp

# --- PostgreSQL ---
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=assistant
# "db" is the compose service name; use "localhost" when running Python outside Docker
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- App ---
DEFAULT_TIMEZONE=Asia/Tehran
# Where downloaded voice messages are stored (a named volume in Docker)
VOICE_STORAGE_DIR=/data/voice
LOG_LEVEL=INFO
# json (production) or text (reading logs locally)
LOG_FORMAT=json
# Messages per Telegram user (button taps are not counted)
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_HOUR=60
# Leftover audio older than this is deleted by a periodic job (every AUDIO_CLEANUP_INTERVAL_MIN)
AUDIO_RETENTION_MIN=60
AUDIO_CLEANUP_INTERVAL_MIN=10

# --- Admin API (FastAPI on 127.0.0.1:8000) ---
# Long random string; send it as header "X-Admin-Key". Empty disables the admin endpoints.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=replace-me-with-a-long-random-string
# true serves interactive docs at /docs (local development only)
DEBUG=false

# --- MCP server ---
# Bearer token for the HTTP transport on 127.0.0.1:8001 (IDEs). Claude Desktop uses stdio and needs none.
MCP_API_KEY=replace-me-with-another-long-random-string

# --- Dashboard (usage & quality) ---
# Public subdomain served by Caddy over HTTPS (needs a DNS A record). Empty = local only, http://127.0.0.1:8080
DASHBOARD_HOST=
# Email for Let's Encrypt certificate notices (used by Caddy)
ACME_EMAIL=you@example.com
# Owner password hash:  docker compose run --rm --no-deps api python -m app.dashboard.auth hash-password
DASHBOARD_PASSWORD_HASH=
# Long random string; signs session cookies and the bot's /dashboard login links
DASHBOARD_SECRET_KEY=replace-me-with-a-third-long-random-string
DASHBOARD_SESSION_HOURS=12
# true: on first start with an empty database, seed 30 days of demo data so the charts are not empty
DEMO_DATA=true
# Read-only database role used by the dashboard (created by the migrate service)
DASHBOARD_DB_USER=dashboard_ro
DASHBOARD_DB_PASSWORD=change-me-too

# --- Speech to text (Vosk) ---
# The Docker image downloads vosk-model-small-fa-0.42 here at build time.
# To use another model, mount it as a volume and point this at it.
VOSK_MODEL_PATH=/opt/vosk-model
# English model (vosk-model-small-en-us-0.15). Used when the user's language setting is "en".
VOSK_MODEL_PATH_EN=/opt/vosk-model-en
# English model (vosk-model-small-en-us-0.15). Used when the user's language setting is "en".
VOSK_MODEL_PATH_EN=/opt/vosk-model-en
# Mean word confidence (0-1) below which the bot asks the user to repeat
STT_MIN_CONFIDENCE=0.6
# Voice messages longer than this (seconds) are refused
STT_MAX_DURATION_S=60
# vosk = offline (one language at a time, from the user's /language setting)
# whisper = Whisper API, detects Persian/English by itself; audio is sent to the provider.
#           If the API fails, Vosk is used instead.
STT_PROVIDER=vosk
# Groq: create a key at https://console.groq.com/keys (the same key as the LLM is fine)
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_MODEL=whisper-large-v3-turbo

# --- LLM (DeepSeek, OpenAI-compatible) ---
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Must be a model your account lists (GET /health names the available ones if this one is wrong).
# As of 2026-10-30: deepseek-flash (V4.1 Flash) or deepseek-v4-pro. deepseek-chat / deepseek-v4-flash no longer exist.
DEEPSEEK_MODEL=deepseek-flash
# Optional JSON merged into each request body (provider-specific switches), e.g. {"thinking": {"type": "disabled"}}
DEEPSEEK_EXTRA_BODY={}
# Per-request timeout (s) and retries for 429/5xx/timeouts
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
# Hard cap on LLM calls per message (1-6)
AGENT_MAX_STEPS=6
# Optional price overrides, USD per 1M tokens (defaults: DeepSeek V4 off-peak list prices, Oct 2026)
# LLM_PRICES={"deepseek-flash": {"input": 0.15, "cached_input": 0.003, "output": 0.60}}
LLM_PRICES=

# --- Token budget (prompt + completion tokens; day/month in DEFAULT_TIMEZONE). 0 = no budget ---
TOKEN_BUDGET_DAILY=200000
TOKEN_BUDGET_MONTHLY=3000000
# Telegram alert to the owner when usage crosses these percentages (once per period)
BUDGET_ALERT_THRESHOLDS=80,100
# true = the bot refuses new requests after 100 %
BUDGET_HARD_STOP=false
# Minutes during which a preview can still be confirmed
CONFIRMATION_TTL_MIN=60
# 👍/👎 buttons under replies (quality signal for the dashboard)
FEEDBACK_BUTTONS=true

# --- Google Calendar (OAuth 2.0 Desktop client; README "Google Calendar setup") ---
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Printed once by: python scripts/google_auth.py
GOOGLE_REFRESH_TOKEN=replace-me
GOOGLE_CALENDAR_ID=primary

# --- Tests only (not read by the app) ---
# Set to 1 to run database tests. They TRUNCATE every table: use a throwaway database.
# RUN_DB_TESTS=0
