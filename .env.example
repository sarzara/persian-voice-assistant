# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Comma-separated numeric Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=111111111

# --- Owner (used by the seed script and the test-email CLI) ---
OWNER_TELEGRAM_ID=111111111
OWNER_NAME=Sahar
OWNER_EMAIL=owner@example.com

# --- Email (Resend) ---
RESEND_API_KEY=re_replace_me
# Must be on a domain verified in Resend; onboarding@resend.dev works for tests sent to your own Resend account email
EMAIL_FROM=Assistant <onboarding@resend.dev>

# --- PostgreSQL ---
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=assistant
# "db" is the compose service name; use "localhost" when running Python outside Docker
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- App ---
DEFAULT_TIMEZONE=Asia/Tehran
# Where downloaded voice messages are stored (a named volume in Docker)
VOICE_STORAGE_DIR=/data/voice
LOG_LEVEL=INFO

# --- Speech to text (Vosk) ---
# The Docker image downloads vosk-model-small-fa-0.42 here at build time.
# To use another model, mount it as a volume and point this at it.
VOSK_MODEL_PATH=/opt/vosk-model
# Mean word confidence (0-1) below which the bot asks the user to repeat
STT_MIN_CONFIDENCE=0.6
# Voice messages longer than this (seconds) are refused
STT_MAX_DURATION_S=120

# --- LLM (DeepSeek, OpenAI-compatible) ---
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Per-request timeout (s) and retries for 429/5xx/timeouts
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
# Hard cap on LLM calls per message (1-6)
AGENT_MAX_STEPS=6

# --- Google Calendar (OAuth 2.0 Desktop client; README "Google Calendar setup") ---
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Printed once by: python scripts/google_auth.py
GOOGLE_REFRESH_TOKEN=replace-me
GOOGLE_CALENDAR_ID=primary

# --- Tests only (not read by the app) ---
# Set to 1 to run database tests. They TRUNCATE every table: use a throwaway database.
# RUN_DB_TESTS=0
